{
	"name": "mcs-platform",
	"version": "0.1.0",
	"description": "Local-first mission control and telemetry workspaces",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"telemetry",
		"mission-control",
		"sensors",
		"dashboard",
		"sqlite"
	],
	"homepage": "https://github.com/larspatkowa/MCS#readme",
	"bugs": {
		"url": "https://github.com/larspatkowa/MCS/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/larspatkowa/MCS.git",
		"directory": "mcs"
	},
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"mcs": "./bin/mcs.js"
	},
	"files": [
		"bin",
		"build",
		"project-format",
		"examples",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"dev": "vite dev",
		"devh": "vite dev --host",
		"build": "vite build",
		"prepack": "npm run build && node scripts/prepare-package.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "npm run test:unit && npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.1",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.0",
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.1.0",
		"postcss": "^8.4.49",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.48.2",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^3.4.15",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"@lucide/svelte": "^0.563.1",
		"bits-ui": "^1.0.0"
	},
	"dependencies": {
		"better-sqlite3": "^12.6.2",
		"clsx": "^2.1.1",
		"playwright": "^1.58.0",
		"tailwind-merge": "^2.5.5"
	}
}
